<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgMain">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/bgCard"
        android:padding="14dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvAreaCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorTextMain"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvAreaCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnPickCity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/area_pick_city"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnPickByShul"
        style="?attr/buttonTonalStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/area_pick_by_shul"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnRadius"
        style="?attr/buttonTonalStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnManageShuls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/area_manage_shuls"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/area_data_header"
        android:textColor="?attr/m3Primary"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/bgCard"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvDataInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorTextMain"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnDownload"
            style="?attr/buttonTonalStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/area_download" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/area_credit"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="12dp" />

</LinearLayout>
</ScrollView>
