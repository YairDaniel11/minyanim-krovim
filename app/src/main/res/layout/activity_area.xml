<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgMain">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvAreaCurrent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextMain"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvAreaCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="13sp"
        android:layout_marginBottom="14dp" />

    <Button
        android:id="@+id/btnPickCity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button"
        android:textColor="#FFFFFF"
        android:text="@string/area_pick_city"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnPickByShul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button"
        android:textColor="#FFFFFF"
        android:text="@string/area_pick_by_shul"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnRadius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnManageShuls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button"
        android:textColor="#FFFFFF"
        android:text="@string/area_manage_shuls"
        android:layout_marginBottom="22dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/area_data_header"
        android:textColor="?attr/colorTextMain"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvDataInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button"
        android:textColor="#FFFFFF"
        android:text="@string/area_download"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnSwitchSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/area_credit"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="6dp" />

</LinearLayout>
</ScrollView>
