<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBgMain"
    android:padding="10dp">

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/shul_list_search_hint"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="?attr/colorTextMain"
        android:textColorHint="?attr/colorTextSecondary" />

    <TextView
        android:id="@+id/tvShulSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="12sp"
        android:padding="4dp" />

    <ListView
        android:id="@+id/listShuls"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@drawable/list_selector_file" />

    <Button
        android:id="@+id/btnShowAll"
        style="?attr/buttonTonalStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/shul_list_show_all"
        android:layout_marginTop="6dp" />

</LinearLayout>
