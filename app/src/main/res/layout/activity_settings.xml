<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgMain">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- קובץ מניינים -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_data_header"
        android:textColor="?attr/colorTextMain"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnLoadFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button"
        android:textColor="#FFFFFF"
        android:text="@string/btn_load_file"
        android:layout_marginBottom="20dp" />

    <!-- ערכת נושא -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_theme_header"
        android:textColor="?attr/colorTextMain"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="10dp" />

    <RadioGroup
        android:id="@+id/rgTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rbThemeSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_system"
            android:textColor="?attr/colorTextMain"
            android:nextFocusDown="@id/rbThemeLight" />

        <RadioButton
            android:id="@+id/rbThemeLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_light"
            android:textColor="?attr/colorTextMain"
            android:nextFocusUp="@id/rbThemeSystem"
            android:nextFocusDown="@id/rbThemeDark" />

        <RadioButton
            android:id="@+id/rbThemeDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_dark"
            android:textColor="?attr/colorTextMain"
            android:nextFocusUp="@id/rbThemeLight" />
    </RadioGroup>

    <!-- התראות -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_alarms_header"
        android:textColor="?attr/colorTextMain"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="10dp" />

    <!-- כל שורת תפילה בנויה כשתי שורות מוערמות (לא צמודות זו לצד זו) -
         כדי שלא ילחצו זו על זו במסכים צרים (ראו activity_main.xml להסבר
         דומה). שורה עליונה: תיבת סימון + תווית. שורה תחתונה: כפתור שעה
         ברוחב מלא. -->

    <!-- שחרית -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <CheckBox android:id="@+id/cbShacharit"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:nextFocusDown="@id/btnTimeShacharit" />
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/settings_enable_shacharit" android:textColor="?attr/colorTextMain" />
    </LinearLayout>
    <Button android:id="@+id/btnTimeShacharit"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button" android:textColor="#FFFFFF"
        android:text="@string/settings_set_time"
        android:layout_marginBottom="16dp"
        android:nextFocusUp="@id/cbShacharit" android:nextFocusDown="@id/cbMincha" />

    <!-- מנחה -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <CheckBox android:id="@+id/cbMincha"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:nextFocusUp="@id/btnTimeShacharit" android:nextFocusDown="@id/btnTimeMincha" />
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/settings_enable_mincha" android:textColor="?attr/colorTextMain" />
    </LinearLayout>
    <Button android:id="@+id/btnTimeMincha"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button" android:textColor="#FFFFFF"
        android:text="@string/settings_set_time"
        android:layout_marginBottom="16dp"
        android:nextFocusUp="@id/cbMincha" android:nextFocusDown="@id/cbArvit" />

    <!-- ערבית -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <CheckBox android:id="@+id/cbArvit"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:nextFocusUp="@id/btnTimeMincha" android:nextFocusDown="@id/btnTimeArvit" />
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/settings_enable_arvit" android:textColor="?attr/colorTextMain" />
    </LinearLayout>
    <Button android:id="@+id/btnTimeArvit"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button" android:textColor="#FFFFFF"
        android:text="@string/settings_set_time"
        android:layout_marginBottom="20dp"
        android:nextFocusUp="@id/cbArvit" android:nextFocusDown="@id/btnBattery" />

    <Button
        android:id="@+id/btnBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button"
        android:textColor="#FFFFFF"
        android:text="@string/settings_ignore_battery"
        android:nextFocusUp="@id/btnTimeArvit" />

</LinearLayout>
</ScrollView>
