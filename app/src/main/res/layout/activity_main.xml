<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBgMain"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:id="@+id/dayRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvNextTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_next_minyan_title"
        android:textColor="?attr/colorTextMain"
        android:textStyle="bold"
        android:textSize="16sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextMain"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvLastTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_last_minyan_title"
        android:textColor="?attr/colorTextMain"
        android:textStyle="bold"
        android:textSize="14sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvLast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="6dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvAllTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_all_minyanim_title"
        android:textColor="?attr/colorTextMain"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listMinyanim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nextFocusUp="@id/tvLast"
            android:divider="@null"
            android:dividerHeight="4dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/label_no_data"
            android:textColor="?attr/colorTextSecondary"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_round_button"
            android:textColor="#FFFFFF"
            android:text="@string/btn_settings"
            android:nextFocusRight="@id/btnRefresh" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_round_button"
            android:textColor="#FFFFFF"
            android:text="@string/btn_refresh"
            android:nextFocusLeft="@id/btnSettings" />
    </LinearLayout>

</LinearLayout>
