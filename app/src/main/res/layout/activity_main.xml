<?xml version="1.0" encoding="utf-8"?>
<!-- הכפתורים (הגדרות / זמני היום / רענון) הועברו לתפריט (מקש התפריט / המקש הימני / שלוש נקודות),
     כדי שלא יתפסו מקום במסך. כל המסך נגלל כיחידה אחת - נוח גם למכשירי מקשים. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgMain"
    android:fillViewport="true"
    android:scrollbars="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="6dp" />

    <!-- שתי שורות קבועות (4+3) שממלאות את כל הרוחב (layout_weight) - כל 7 הימים תמיד גלויים,
         בלי גלילה אופקית (לא אמינה בניווט מקשים). -->
    <LinearLayout
        android:id="@+id/dayRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvNextTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_next_minyan_title"
        android:textColor="?attr/colorTextSecondary"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/bgCard"
        android:textColor="?attr/colorNext"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="14dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvLastTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_last_minyan_title"
        android:textColor="?attr/colorTextSecondary"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvLast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/bgCard"
        android:textColor="?attr/colorTextMain"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvAllTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_all_minyanim_title"
        android:textColor="?attr/colorTextSecondary"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <!-- רשימת המניינים נבנית בקוד (LinearLayout רגיל, לא ListView) כדי להיגלל יחד עם כל המסך -->
    <LinearLayout
        android:id="@+id/listMinyanim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_no_data"
        android:textColor="?attr/colorTextSecondary"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

</LinearLayout>
</ScrollView>
