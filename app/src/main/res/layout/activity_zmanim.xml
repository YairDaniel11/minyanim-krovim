<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgMain"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvZmanimDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextMain"
        android:textStyle="bold"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvZmanimDisclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/zmanim_disclaimer"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:id="@+id/zmanimList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tvZmanimEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/zmanim_no_location"
        android:textColor="?attr/colorTextSecondary"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvZmanimSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp" />

    <!-- הגדרת מיקום ידנית -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/zmanim_set_location"
        android:textColor="?attr/colorTextMain"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/zmanim_city_picker_label"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerCity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button"
        android:spinnerMode="dialog"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/etLat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:inputType="numberDecimal|numberSigned"
            android:hint="@string/zmanim_lat_hint"
            android:textColor="?attr/colorTextMain" />

        <EditText
            android:id="@+id/etLon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal|numberSigned"
            android:hint="@string/zmanim_lon_hint"
            android:textColor="?attr/colorTextMain" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_button"
        android:textColor="#FFFFFF"
        android:text="@string/zmanim_save_location" />

</LinearLayout>
</ScrollView>
