<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgMain"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvZmanimDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextMain"
        android:textStyle="bold"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/tvZmanimSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:id="@+id/zmanimList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/bgCard"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <TextView
        android:id="@+id/tvZmanimEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/zmanim_no_location"
        android:textColor="?attr/colorTextSecondary"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvZmanimDisclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/zmanim_disclaimer"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="10dp" />

</LinearLayout>
</ScrollView>
