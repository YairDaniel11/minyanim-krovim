<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m3d_primary_pressed" />
            <corners android:radius="20dp" />
            <padding android:left="16dp" android:top="10dp" android:right="16dp" android:bottom="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m3d_primary" />
            <stroke android:width="3dp" android:color="@color/m3d_on_surface" />
            <corners android:radius="20dp" />
            <padding android:left="16dp" android:top="10dp" android:right="16dp" android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m3d_primary" />
            <corners android:radius="20dp" />
            <padding android:left="16dp" android:top="10dp" android:right="16dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>
