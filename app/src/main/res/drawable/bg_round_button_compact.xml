<?xml version="1.0" encoding="utf-8"?>
<!-- זהה ל-bg_round_button.xml, אבל עם padding מוקטן משמעותית - מיועד רק
     לשלושת הכפתורים הקטנים בשורה התחתונה של המסך הראשי (הגדרות/זמני
     היום/רענון), כדי שיתפסו פחות מקום במסכים קטנים של מכשירי מקשים. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#00695C" />
            <corners android:radius="8dp" />
            <padding android:top="8dp" android:bottom="8dp" android:left="4dp" android:right="4dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00ACC1" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="8dp" />
            <padding android:top="8dp" android:bottom="8dp" android:left="4dp" android:right="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00897B" />
            <corners android:radius="8dp" />
            <padding android:top="8dp" android:bottom="8dp" android:left="4dp" android:right="4dp" />
        </shape>
    </item>
</selector>
